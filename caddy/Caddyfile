{
    admin off
}

:80 {
    # WebSocket proxy — ПРАВИЛЬНЫЙ синтаксис Caddy v2
    handle /ws/chat {
        reverse_proxy http://nanobot:8765 {
            header_up Host {host}
            header_up Origin {http.request.header.Origin}
            header_up Upgrade {http.request.header.Upgrade}
            header_up Connection {http.request.header.Connection}
            header_up Sec-WebSocket-Key {http.request.header.Sec-WebSocket-Key}
            header_up Sec-WebSocket-Version {http.request.header.Sec-WebSocket-Version}
        }
    }
    
    # Backend API
    handle /items* {
        reverse_proxy http://backend:8000
    }
    handle /health {
        reverse_proxy http://backend:8000
    }
    
    # Flutter web app
    handle_path /flutter* {
        root * /srv/flutter
        try_files {path} /index.html
        file_server
    }
    
    # Default
    handle {
        root * /srv/flutter
        file_server
    }
}
